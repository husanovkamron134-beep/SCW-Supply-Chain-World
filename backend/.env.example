# Copy these into the backend host's Environment settings; never commit real secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SCW_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SCW_TOKEN_MINUTES=720
SCW_CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
